# Copy to .env (gitignored) on each machine and fill in. See docs/HANDOFF.md.
# Short unique machine tag, used in run IDs (S-10), e.g. aadit-mbp, lab-ws1, hpc
GNN_MARL_MACHINE=
# Where training runs are written (HPC: project/work storage, not $HOME)
GNN_MARL_RUNS_DIR=./runs
# Local cache of pulled/published artifacts (docs/ARTIFACTS.md)
GNN_MARL_ARTIFACTS=./artifacts/cache
# Artifact store repo id (pending Q-07), e.g. <hf-org>/gnn-marl-bluesky-artifacts
GNN_MARL_ARTIFACT_REPO=
# Do NOT put tokens here if this file could be shared; prefer `hf auth login` per machine.
